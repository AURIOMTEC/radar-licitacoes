# Copie para .env (na VPS: /var/www/radar/.env) e ajuste.

# Porta local (o nginx faz o HTTPS e o proxy). ERP=5000, site=5001.
PORT=5002

# Login do navegador. Deixe APP_USER vazio só se rodar no próprio PC.
APP_USER=auriomtec
APP_PASSWORD=troque-esta-senha
# Endereço público, usado no link "Ver no app" das mensagens de WhatsApp
APP_PUBLIC_URL=https://licitacoes.auriomtec.com.br

# Banco SQLite próprio do Radar (não usa o Postgres do ERP)
DB_PATH=data/radar.db

# --- Coleta PNCP (VPS de 2 núcleos: tudo pesado só de madrugada)
COLETA_AUTOMATICA=1
JANELA_COLETA=01:30-05:30
ALERTA_HORARIO=07:00
# 4 Concorrência Eletr., 5 Concorrência Pres., 6 Pregão Eletr., 7 Pregão Pres.,
# 8 Dispensa, 10 Manifestação de Interesse, 12 Credenciamento
MODALIDADES_COLETA=4,5,6,7,8,10,12
# Limite de encerramento das propostas consultado (hoje + N dias)
DATA_FINAL_DIAS=730
# A API real aceita no máximo 50
PNCP_PAGE_SIZE=50
PNCP_REQ_POR_SEGUNDO=2
ITENS_CONCORRENCIA=2
ITENS_LOTE=300
ITENS_PAUSA_S=20
PURGA_DIAS=2

# --- WhatsApp: evolution | zapi | none
WHATSAPP_PROVIDER=none

# Evolution API (gratuita, self-hosted)
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_APIKEY=

# Z-API (pago, hospedado)
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

ALERTA_MAX_POR_MSG=8
